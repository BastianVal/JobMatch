# Copiar fuera del repositorio como /srv/jobmatch/.env y sustituir cada valor.
APP_HOST=jobs.example.com
POSTGRES_DB=jobmatch
POSTGRES_USER=jobmatch
POSTGRES_PASSWORD=replace-with-a-long-random-password
JOBMATCH_BACKEND_IMAGE=docker.io/your-dockerhub-username/jobmatch-backend
JOBMATCH_FRONTEND_IMAGE=docker.io/your-dockerhub-username/jobmatch-frontend
JOBMATCH_IMAGE_TAG=replace-with-an-immutable-git-sha
TOKEN_SECRET=replace-with-at-least-32-random-bytes
RATE_LIMIT_PEPPER=replace-with-an-independent-random-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
POSTGRES_CPUS=2.0
POSTGRES_MEMORY_LIMIT=2g
API_CPUS=1.0
API_MEMORY_LIMIT=1024m
WORKER_CPUS=1.0
WORKER_MEMORY_LIMIT=768m
