APP_HOST=localhost
POSTGRES_DB=jobmatch
POSTGRES_USER=jobmatch
POSTGRES_PASSWORD=change-me
JOBMATCH_IMAGE_TAG=local
HTTP_PORT=8090
HTTPS_PORT=8443
TOKEN_SECRET=replace-with-at-least-32-random-bytes
RATE_LIMIT_PEPPER=replace-with-an-independent-random-secret
# Valores iniciales para producción; ajústalos al tamaño de la instancia EC2.
POSTGRES_CPUS=2.0
POSTGRES_MEMORY_LIMIT=2g
API_CPUS=1.0
API_MEMORY_LIMIT=1024m
WORKER_CPUS=1.0
WORKER_MEMORY_LIMIT=768m
